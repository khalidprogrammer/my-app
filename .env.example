# Copy to `.env` and adjust. See Architecture.md §11 for production variables.
#
# --- Database (required) ---
# MySQL (local WAMP default). Create the database first:
#   mysql -u root -e "CREATE DATABASE IF NOT EXISTS import_export_web CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
DATABASE_URL="mysql://root:@localhost:3306/import_export_web"
#
# PostgreSQL alternative (recommended by database_schema.md; change
# `provider` in prisma/schema.prisma to "postgresql" if you use this):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/import_export_web?schema=public"
#
# --- Public site URL (required for canonical links, sitemap, robots) ---
# Production: https://your-domain.com — inlined at build time, so set it on the
# host before the first deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# --- Uploaded media storage (optional; defaults to ./data/uploads) ---
# Admin uploads are deliberately kept OUT of public/ so they survive rebuilds
# on hosts that build with `output: "standalone"` (e.g. Hostinger). Point this
# at a persistent path outside the app directory in production, e.g.
#   UPLOAD_DIR=/home/u123456789/uploads
# Files are served by app/uploads/[...path]/route.ts; /uploads/... URLs are
# unchanged either way.
# UPLOAD_DIR=./data/uploads
#
# --- Initial admin seeding (used by `npm run db:seed`; change after first login) ---
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=change-me-immediately
#
# --- Reserved for future phases (not used yet) ---
# STORAGE_ENDPOINT=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=
# EMAIL_SERVER=
