// Prisma schema — Phase 1: Database foundation.
// Source of truth: database_schema.md + PRD.md + Architecture.md.
//
// Provider: mysql (WAMP local). database_schema.md also allows PostgreSQL;
// switching providers later requires a new migration but no model changes
// (all field types used here exist in both).
//
// Conventions:
// - CUID string PKs, snake_case columns via @map/@@map matching database_schema.md.
// - Enums use UPPER_CASE Prisma values mapped to the lowercase DB values
//   from the spec (avoids reserved words such as `new` in generated client).
// - Soft-delete (`deleted_at`) on categories/products/services/news_articles.
// - `EXTENSION` comments mark additive nullable columns required by PRD.md
//   that database_schema.md v1 does not define (services benefits/process/CTA,
//   SEO keywords). They are optional and forward-compatible.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum CategoryStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum ProductStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")
}

enum ServiceStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")
}

enum NewsStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")
}

enum MarketType {
  IMPORT @map("import")
  EXPORT @map("export")
  BOTH   @map("both")
}

enum MarketStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum QuoteStatus {
  NEW            @map("new")
  CONTACTED      @map("contacted")
  QUOTATION_SENT @map("quotation_sent")
  NEGOTIATION    @map("negotiation")
  CONFIRMED      @map("confirmed")
  COMPLETED      @map("completed")
  REJECTED       @map("rejected")
  ARCHIVED       @map("archived")
}

enum ContactStatus {
  NEW      @map("new")
  READ     @map("read")
  REPLIED  @map("replied")
  ARCHIVED @map("archived")
}

enum SettingType {
  STRING  @map("string")
  TEXT    @map("text")
  NUMBER  @map("number")
  BOOLEAN @map("boolean")
  JSON    @map("json")
}

enum HomepageSectionStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum GalleryStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

// ---------------------------------------------------------------------------
// Auth / RBAC: users, roles, permissions (+ join tables)
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  name         String     @db.VarChar(191)
  email        String     @unique @db.VarChar(191)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  userRoles        UserRole[]
  createdProducts  Product[]            @relation("ProductCreatedBy")
  updatedProducts  Product[]            @relation("ProductUpdatedBy")
  assignedQuotes   Quote[]              @relation("QuoteAssignedTo")
  assignedContacts ContactMessage[]     @relation("ContactAssignedTo")
  authoredArticles NewsArticle[]        @relation("ArticleAuthor")
  uploadedMedia    Media[]              @relation("MediaUploadedBy")
  statusChanges    QuoteStatusHistory[] @relation("StatusChangedBy")
  updatedSettings  SiteSetting[]        @relation("SettingUpdatedBy")
  auditLogs        AuditLog[]
  sessions         Session[]

  @@index([status])
  @@map("users")
}

// EXTENSION (Phase 4): DB-backed admin sessions. Not in database_schema.md v1;
// required for revocable email/password authentication (Architecture.md §6).
model Session {
  id        String   @id @default(cuid())
  // SHA-256 hex of the opaque session token (the token itself is never stored).
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Catalog: categories, products, images, specifications
// ---------------------------------------------------------------------------

model Category {
  id             String         @id @default(cuid())
  parentId       String?        @map("parent_id")
  name           String         @db.VarChar(191)
  slug           String         @unique @db.VarChar(191)
  description    String?        @db.Text
  imageId        String?        @map("image_id")
  sortOrder      Int            @default(0) @map("sort_order")
  status         CategoryStatus @default(ACTIVE)
  seoTitle       String?        @map("seo_title") @db.VarChar(255)
  seoDescription String?        @map("seo_description") @db.Text
  // EXTENSION (PRD §8): per-category SEO keywords; nullable, additive.
  seoKeywords    String?        @map("seo_keywords") @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryChildren")
  image    Media?     @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([parentId])
  @@index([status])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id               String        @id @default(cuid())
  categoryId       String        @map("category_id")
  name             String        @db.VarChar(255)
  slug             String        @unique @db.VarChar(191)
  sku              String?       @unique @db.VarChar(100)
  shortDescription String?       @map("short_description") @db.Text
  description      String?       @db.Text
  brand            String?       @db.VarChar(191)
  model            String?       @db.VarChar(191)
  origin           String?       @db.VarChar(191)
  applications     String?       @db.Text
  packaging        String?       @db.VarChar(255)
  moq              Decimal?      @db.Decimal(12, 3)
  unit             String?       @db.VarChar(50)
  featured         Boolean       @default(false)
  status           ProductStatus @default(DRAFT)
  seoTitle         String?       @map("seo_title") @db.VarChar(255)
  seoDescription   String?       @map("seo_description") @db.Text
  // EXTENSION (PRD §6): product SEO keywords; nullable, additive.
  seoKeywords      String?       @map("seo_keywords") @db.VarChar(500)
  createdBy        String?       @map("created_by")
  updatedBy        String?       @map("updated_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  category   Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator    User?                  @relation("ProductCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater    User?                  @relation("ProductUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  images     ProductImage[]
  specs      ProductSpecification[]
  quoteItems QuoteItem[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  mediaId   String   @map("media_id")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([mediaId])
  @@map("product_images")
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  name      String   @db.VarChar(191)
  value     String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specifications")
}

// ---------------------------------------------------------------------------
// Services & markets
// ---------------------------------------------------------------------------

model Service {
  id               String        @id @default(cuid())
  name             String        @db.VarChar(255)
  slug             String        @unique @db.VarChar(191)
  shortDescription String?       @map("short_description") @db.Text
  description      String?       @db.Text
  imageId          String?       @map("image_id")
  // EXTENSIONS (PRD §5.4): structured benefits / process / CTA per service.
  benefits         Json?
  process          Json?
  cta              Json?
  sortOrder        Int           @default(0) @map("sort_order")
  status           ServiceStatus @default(DRAFT)
  seoTitle         String?       @map("seo_title") @db.VarChar(255)
  seoDescription   String?       @map("seo_description") @db.Text
  // EXTENSION (PRD §8): per-service SEO keywords; nullable, additive.
  seoKeywords      String?       @map("seo_keywords") @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  image Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([sortOrder])
  @@map("services")
}

model Market {
  id          String       @id @default(cuid())
  name        String       @db.VarChar(191)
  slug        String       @unique @db.VarChar(191)
  countryCode String?      @map("country_code") @db.VarChar(10)
  type        MarketType   @default(BOTH)
  description String?      @db.Text
  imageId     String?      @map("image_id")
  status      MarketStatus @default(ACTIVE)
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  image Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@map("markets")
}

// ---------------------------------------------------------------------------
// Quotes / inquiries
// ---------------------------------------------------------------------------

model Quote {
  id           String      @id @default(cuid())
  referenceNo  String      @unique @map("reference_no") @db.VarChar(50)
  customerName String      @map("customer_name") @db.VarChar(191)
  companyName  String?     @map("company_name") @db.VarChar(191)
  email        String      @db.VarChar(191)
  phone        String?     @db.VarChar(50)
  country      String?     @db.VarChar(100)
  city         String?     @db.VarChar(100)
  destination  String?     @db.VarChar(255)
  message      String?     @db.Text
  attachmentId String?     @map("attachment_id")
  status       QuoteStatus @default(NEW)
  assignedTo   String?     @map("assigned_to")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  attachment Media?                @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  assignee   User?                 @relation("QuoteAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)
  items      QuoteItem[]
  history    QuoteStatusHistory[]

  @@index([status])
  @@index([email])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String   @map("quote_id")
  productId   String?  @map("product_id")
  // Snapshot of the product name: historical inquiries stay readable
  // even if the product is later renamed or archived.
  productName String   @map("product_name") @db.VarChar(255)
  quantity    Decimal  @db.Decimal(12, 3)
  unit        String?  @db.VarChar(50)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
  @@map("quote_items")
}

model QuoteStatusHistory {
  id        String   @id @default(cuid())
  quoteId   String   @map("quote_id")
  // Stored as plain strings (spec: varchar) so history survives enum changes.
  oldStatus String?  @map("old_status") @db.VarChar(50)
  newStatus String   @map("new_status") @db.VarChar(50)
  changedBy String?  @map("changed_by")
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  quote   Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  changer User? @relation("StatusChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@map("quote_status_history")
}

// ---------------------------------------------------------------------------
// News
// ---------------------------------------------------------------------------

model NewsCategory {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(191)
  slug      String   @unique @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  articles NewsArticle[]

  @@map("news_categories")
}

model NewsArticle {
  id              String     @id @default(cuid())
  categoryId      String?    @map("category_id")
  title           String     @db.VarChar(255)
  slug            String     @unique @db.VarChar(191)
  excerpt         String?    @db.Text
  content         String     @db.MediumText
  featuredImageId String?    @map("featured_image_id")
  authorId        String?    @map("author_id")
  status          NewsStatus @default(DRAFT)
  publishedAt     DateTime?  @map("published_at")
  seoTitle        String?    @map("seo_title") @db.VarChar(255)
  seoDescription  String?    @map("seo_description") @db.Text
  // EXTENSION (PRD §8): per-article SEO keywords; nullable, additive.
  seoKeywords     String?    @map("seo_keywords") @db.VarChar(500)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  category       NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredImage  Media?        @relation("ArticleFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  author         User?         @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@map("news_articles")
}

// ---------------------------------------------------------------------------
// Media, contact messages, site settings, homepage, audit logs
// ---------------------------------------------------------------------------

model Media {
  id          String    @id @default(cuid())
  fileName    String    @map("file_name") @db.VarChar(255)
  storageKey  String    @unique @map("storage_key") @db.VarChar(512)
  url         String    @db.Text
  mimeType    String    @map("mime_type") @db.VarChar(100)
  fileSize    BigInt    @map("file_size")
  width       Int?
  height      Int?
  altText     String?   @map("alt_text") @db.VarChar(255)
  uploadedBy  String?   @map("uploaded_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  uploader         User?           @relation("MediaUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)
  productImages    ProductImage[]
  categoryImages   Category[]      @relation("CategoryImage")
  serviceImages    Service[]
  marketImages     Market[]
  galleryCovers    GalleryAlbum[]  @relation("AlbumCover")
  galleryItems     GalleryItem[]
  articleImages    NewsArticle[]   @relation("ArticleFeaturedImage")
  quoteAttachments Quote[]
  sectionImages    HomepageSection[] @relation("SectionImage")

  @@index([mimeType])
  @@index([uploadedBy])
  @@map("media")
}

model ContactMessage {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(191)
  companyName String?       @map("company_name") @db.VarChar(191)
  email       String        @db.VarChar(191)
  phone       String?       @db.VarChar(50)
  subject     String?       @db.VarChar(255)
  message     String        @db.Text
  status      ContactStatus @default(NEW)
  assignedTo  String?       @map("assigned_to")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  assignee User? @relation("ContactAssignedTo", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([assignedTo])
  @@map("contact_messages")
}

model SiteSetting {
  id        String      @id @default(cuid())
  key       String      @unique @db.VarChar(191)
  value     String?     @db.Text
  type       SettingType @default(STRING)
  updatedBy String?     @map("updated_by")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  updater User? @relation("SettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

model HomepageSection {
  id           String                @id @default(cuid())
  sectionKey   String                @unique @map("section_key") @db.VarChar(100)
  title        String?               @db.VarChar(255)
  subtitle     String?               @db.Text
  content      String?               @db.Text
  imageId      String?               @map("image_id")
  settingsJson Json?                 @map("settings_json")
  sortOrder    Int                   @default(0) @map("sort_order")
  status       HomepageSectionStatus @default(ACTIVE)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  image Media? @relation("SectionImage", fields: [imageId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("homepage_sections")
}

// ---------------------------------------------------------------------------
// Gallery: albums + items (photos reference the media library)
// ---------------------------------------------------------------------------

model GalleryAlbum {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(191)
  slug        String        @unique @db.VarChar(191)
  description String?       @db.Text
  coverId     String?       @map("cover_id")
  sortOrder   Int           @default(0) @map("sort_order")
  status      GalleryStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  cover Media?        @relation("AlbumCover", fields: [coverId], references: [id], onDelete: SetNull)
  items GalleryItem[]

  @@index([status])
  @@index([sortOrder])
  @@map("gallery_albums")
}

model GalleryItem {
  id        String   @id @default(cuid())
  albumId   String   @map("album_id")
  mediaId   String   @map("media_id")
  caption   String?  @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media Media        @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([albumId])
  @@index([mediaId])
  @@map("gallery_items")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
